{
  "name": "dsh-fd-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness workspace for function-definition workflows",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "setup:dsh": "bash scripts/setup-dsh-profile.sh",
    "dev:web": "bash scripts/start-dsh.sh --port 3081",
    "build": "pnpm run -r build",
    "migrate:signals": "node scripts/migrate-signal-data-to-sqlite.mjs",
    "test": "pnpm run -r test"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "latest",
    "cardinal": "^2.1.1",
    "cordis": "^3.0.0"
  }
}
