# SQLite databases used by knowledge, signal, and workflow plugins
DATABASE_PATH=./data/harness.db
VECTOR_DB_PATH=./data/vectors.db

# The current enterprise-auth plugin still uses MySQL; its data is not migrated to SQLite.
MYSQL_URL=mysql://user:password@127.0.0.1:3306/hermes
JWT_SECRET=replace-with-a-random-secret
SIGNATURE_SECRET=replace-with-another-random-secret
USER_DATA_ROOT=./data/workspace-ai/users

# Embedding service used for knowledge-base indexing and semantic search
EMBEDDING_BASE_URL=https://qianfan.baidubce.com/v2
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding-4b
EMBEDDING_DIMENSION=2560
VECTOR_COLLECTION=function_def_chunks

# Uploaded source files are stored locally and are not committed to Git.
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./data/workspace-ai/shared/knowledge
MAX_UPLOAD_SIZE=104857600

DEEPSEEK_API_KEY=
